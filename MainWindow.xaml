<Window x:Class="LoLHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:LoLHelper.Controls"
        Title="LoLHelper" Width="540" Height="556" MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent"
        Foreground="{StaticResource PrimaryText}"
        FontFamily="{StaticResource AppFont}" FontSize="12" Icon="Assets/app.png"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" GlassFrameThickness="0" ResizeBorderThickness="5" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}"
            CornerRadius="{StaticResource ControlRadius}">
        <Grid>
            <Grid x:Name="AppSurface">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="24,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="LoLHelper" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="国际服助手" Foreground="{StaticResource MutedText}" Margin="12,2,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Style="{StaticResource WindowButton}" Content="&#xE897;" ToolTip="使用帮助" AutomationProperties.Name="使用帮助" Click="HelpButton_Click" />
                            <Button Style="{StaticResource WindowButton}" Content="&#xE921;" ToolTip="最小化" AutomationProperties.Name="最小化" Click="MinimizeButton_Click" />
                            <Button Style="{StaticResource WindowButton}" Content="&#xE8BB;" ToolTip="关闭" AutomationProperties.Name="关闭" Click="CloseButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
                <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="{StaticResource PageInset}">
                    <StackPanel x:Name="PageContent">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Riot 客户端" Style="{StaticResource SectionTitle}" />
                                    <Ellipse x:Name="ConnectionDot" Width="5" Height="5" Margin="10,0,6,0" Fill="{StaticResource MutedText}" />
                                    <TextBlock x:Name="ConnectionText" Text="检测中" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="ProcessStatusText" Text="正在验证进程签名…" Style="{StaticResource Caption}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <Button x:Name="RefreshButton" Grid.Column="1" Content="重新检测" Click="RefreshButton_Click" VerticalAlignment="Top" />
                        </Grid>
                        <ScrollViewer x:Name="ProcessListScroll" MaxHeight="104" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" Margin="0,12,0,0">
                            <ItemsControl x:Name="ProcessPreview">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Image Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Left" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding ProcessId, StringFormat=PID {0}}" Foreground="{StaticResource MutedText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border Style="{StaticResource Divider}" />
                        <TextBlock Text="游戏语言" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="LocaleStatusText" Text="正在检查配置…" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="LocaleDetailText" Text="应用后请重启客户端，等待语言资源更新。" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button x:Name="UnlockButton" Content="解除锁定" IsEnabled="False" Click="UnlockButton_Click" Margin="0,0,8,0"
                                    ToolTip="保留当前语言，允许客户端修改配置" />
                            <Button x:Name="ApplyLocaleButton" Content="应用简体中文" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="ApplyLocaleButton_Click" />
                        </StackPanel>
                        <Border Style="{StaticResource Divider}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="台服安装器" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="DownloadPhaseText" Grid.Column="1" Text="等待下载" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        </Grid>
                        <TextBlock x:Name="DownloadStatusText" Text="Riot 官方下载，完成后自动验证数字签名。" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        <ProgressBar x:Name="DownloadProgressBar" Height="4" Margin="0,16,0,8" Minimum="0" Maximum="100" Value="0" AutomationProperties.Name="安装器下载进度" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="DownloadedText" Text="支持暂停与断点续传" Foreground="{StaticResource MutedText}" />
                            <TextBlock x:Name="SpeedText" Grid.Column="1" Foreground="{StaticResource MutedText}" Margin="12,0,0,0" />
                            <TextBlock x:Name="DownloadPercentText" Grid.Column="2" Text="—" Foreground="{StaticResource MutedText}" Margin="12,0,0,0" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button x:Name="CancelDownloadButton" Content="取消下载" Margin="0,0,8,0" IsEnabled="False" Click="CancelDownloadButton_Click" />
                            <Button x:Name="DownloadButton" Content="下载安装器" Style="{StaticResource ActionButton}" Click="DownloadButton_Click" />
                            <Button x:Name="InstallButton" Content="立即安装" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Click="InstallButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Background="{StaticResource SubtleBrush}" Padding="24,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="非 Riot Games 官方产品" Foreground="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center" />
                        <TextBlock x:Name="FooterStatusText" Grid.Column="1" Text="就绪" Foreground="{StaticResource MutedText}" FontSize="10"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </Grid>
                </Border>
            </Grid>
            <local:ModalHost x:Name="DialogHost" Panel.ZIndex="100" Visibility="Collapsed" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        </Grid>
    </Border>
</Window>
